# Directory views for the wiki note types, plus contextual views that a
# person or area note embeds to list what points at it.
filters:
  and:
    - '!file.inFolder("Templates")'
views:
  - type: table
    name: People
    filters:
      and:
        - type == "person"
    order:
      - file.name
      - role
      - team
      - areas
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Areas
    filters:
      and:
        - type == "area"
    order:
      - file.name
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: SOPs
    filters:
      and:
        - type == "sop"
    order:
      - file.name
      - owner
      - areas
      - reviewed
    sort:
      - property: reviewed
        direction: ASC
  - type: table
    name: Decisions
    filters:
      and:
        - type == "decision"
    order:
      - file.name
      - date
      - status
      - deciders
      - areas
    sort:
      - property: date
        direction: DESC
  - type: table
    name: Meetings
    filters:
      and:
        - type == "meeting"
    order:
      - file.name
      - date
      - attendees
    sort:
      - property: date
        direction: DESC
  - type: table
    name: Responsible
    filters:
      and:
        - type == "person"
        - list(areas).contains(this)
    order:
      - file.name
      - role
      - team
  - type: table
    name: In area
    filters:
      and:
        - type != "person"
        - list(areas).contains(this)
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - status
      - owner
  - type: table
    name: Owns
    filters:
      and:
        - list(owner).contains(this)
    order:
      - file.name
      - type
      - reviewed
  - type: table
    name: Decided
    filters:
      and:
        - type == "decision"
        - list(deciders).contains(this)
    order:
      - file.name
      - date
      - status
    sort:
      - property: date
        direction: DESC
  - type: table
    name: Attended
    filters:
      and:
        - type == "meeting"
        - list(attendees).contains(this)
    order:
      - file.name
      - date
    sort:
      - property: date
        direction: DESC
